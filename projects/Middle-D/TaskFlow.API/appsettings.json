{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=taskflow_db;Username=taskflow_user;Password=taskflow_pass;Application Name=taskflow-api;Maximum Pool Size=50",
    "HangfireConnection": "Host=localhost;Port=5434;Database=taskflow_db;Username=taskflow_user;Password=taskflow_pass;Application Name=taskflow-hangfire;Maximum Pool Size=20"
  },
  "Jwt": {
    "SecretKey": "taskflow-super-secret-key-minimum-32-characters!!",
    "Issuer": "TaskFlowApi",
    "Audience": "TaskFlowClient",
    "AccessTokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "taskflow_user",
    "Password": "taskflow_pass",
    "ExchangeName": "taskflow_exchange"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "taskflow_user",
    "SecretKey": "taskflow_pass123",
    "BucketName": "taskflowfiles",
    "UseSSL": false
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5
  }
}
